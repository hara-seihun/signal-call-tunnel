+/// Selects which audio device backend a [`PeerConnectionFactory`] uses.
+///
+/// `Cubeb` is the default and drives a real local audio device. `Custom`
+/// delegates all audio I/O to a caller-supplied [`CustomAudioDevice`], which is
+/// useful for headless/server use or for bridging audio to another transport
+/// without touching any host audio device.
+///
+/// Cloning a `Custom` backend shares the same device instance; constructing two
+/// `PeerConnectionFactory`s from one such backend is not supported.
+#[derive(Clone, Default)]
+pub enum AudioBackend {
+    /// Use the real cubeb-backed audio device module.
+    #[default]
+    Cubeb,
+    /// Delegate audio I/O to a caller-supplied device.
+    #[cfg(all(not(feature = "sim"), feature = "native"))]
+    Custom(Arc<dyn CustomAudioDevice>),
+}
+
+impl std::fmt::Debug for AudioBackend {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            AudioBackend::Cubeb => write!(f, "Cubeb"),
+            #[cfg(all(not(feature = "sim"), feature = "native"))]
+            AudioBackend::Custom(_) => write!(f, "Custom(..)"),
+        }
+    }
+}
